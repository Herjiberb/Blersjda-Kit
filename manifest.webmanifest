{
  "id": "/blersjda-madness",
  "name": "Blersjda Madness",
  "short_name": "Blersjda",
  "description": "The ultimate party game. Host and play from just your phone, or join a friend's room.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f0a29",
  "theme_color": "#0f0a29",
  "categories": [
    "games",
    "entertainment",
    "social"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-new",
      "auto"
    ]
  },
  "handle_links": "preferred",
