  "shortcuts": [
    {
      "name": "Host on this phone",
      "short_name": "Phone host",
      "description": "Host and play from one device",
      "url": "./?mode=phone&source=shortcut",
      "icons": [
        {
          "src": "icons/shortcut-host-phone.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Host on a big screen",
      "short_name": "Host",
      "url": "./?mode=host&source=shortcut",
      "icons": [
        {
          "src": "icons/shortcut-host.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Join a game",
      "short_name": "Join",
      "url": "./?mode=join&source=shortcut",
      "icons": [
        {
          "src": "icons/shortcut-join.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+blersjda",
      "url": "./?room=%s"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/phone-menu.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Host from your phone"
    },
    {
      "src": "screenshots/phone-host.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Lobby with join code"
    },
    {
      "src": "screenshots/wide-menu.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Big-screen hosting"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://YOUR-DOMAIN/manifest.webmanifest"
    }
  ]
